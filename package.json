{
  "name": "task-reminder",
  "version": "0.9.0",
  "description": "A simple personal task reminder for Windows that lives in the system tray.",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node22 --format=cjs --external:electron --outfile=dist/main/index.js",
    "build:preload": "esbuild src/preload/api.ts --bundle --platform=node --target=node22 --format=cjs --external:electron --outfile=dist/preload/api.js",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "dist:win:zip": "npm run build && electron-builder --win zip"
  },
  "author": "Hani Kortam",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.7",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.4.6",
    "vitest": "^3.2.7",
    "zod": "^3.25.76"
  },
  "productName": "Task Reminder",
  "private": true,
  "type": "commonjs",
  "build": {
    "appId": "com.hani.taskreminder",
    "productName": "Task Reminder",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "resources/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/main/index.js"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "TaskReminder-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "TaskReminder-Portable-${version}.exe"
    }
  }
}